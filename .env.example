# Copy this to .env to override anything. Every value here is already the
# default, so .env is optional.

# Where the data lives, as a SQLAlchemy URL. Defaults to a local SQLite file so
# the service runs straight after a clone. Docker Compose sets the PostgreSQL
# one below.
DATABASE_URL=sqlite+pysqlite:///./medication_requests.db
# The compose database, published on host port 5433.
# DATABASE_URL=postgresql+psycopg://medication:medication@localhost:5433/medication_requests

# Log every SQL statement. Useful when working out what the ORM is doing,
# noisy the rest of the time.
SQL_ECHO=false

LOG_LEVEL=INFO
